{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bücher",
  "version": "0.1.0",
  "identifier": "com.mateusdcc.bucher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bücher",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#171717"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost; media-src asset: http://asset.localhost https://asset.localhost; connect-src ipc: http://ipc.localhost;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/Buches/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
